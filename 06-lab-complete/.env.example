# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore — KHÔNG commit)
# Không ghi secret thật vào file này.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt key thật trong .env hoặc biến môi trường của platform
AGENT_API_KEY=change-me

# Redis (docker compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit & cost guard
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
